{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smilintux.github.io/skrsi/schemas/evaluation-v1.schema.json",
  "title": "SKRSI evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evaluation_id", "target_ref", "evaluator", "producer", "baseline", "treatment", "metrics", "guardrails", "missingness", "outcome", "evidence_sha256"],
  "properties": {
    "schema": {"const": "skrsi.evaluation.v1"},
    "evaluation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "target_ref": {"type": "string", "pattern": "^[a-z0-9._-]+@[1-9][0-9]*$"},
    "evaluator": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "baseline": {"$ref": "#/$defs/cohort"},
    "treatment": {"$ref": "#/$defs/cohort"},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": {"type": "string"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "missingness": {"type": "array", "items": {"type": "string"}},
    "outcome": {"enum": ["pass", "fail", "blocked", "inconclusive", "regression"]},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "cohort": {"type": "object", "additionalProperties": false, "required": ["id", "sample_size", "window_start", "window_end"], "properties": {"id": {"type": "string"}, "sample_size": {"type": "integer", "minimum": 0}, "window_start": {"type": "string", "format": "date-time"}, "window_end": {"type": "string", "format": "date-time"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["name", "unit", "baseline", "treatment"], "properties": {"name": {"type": "string"}, "unit": {"type": "string"}, "baseline": {"type": ["number", "null"]}, "treatment": {"type": ["number", "null"]}}}
  }
}
