{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smilintux.github.io/skrsi/schemas/evaluation-v4.schema.json",
  "title": "SKRSI evaluation v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evaluation_id",
    "target_ref",
    "participants",
    "baseline",
    "treatment",
    "metrics",
    "guardrails",
    "missingness",
    "evidence_class",
    "instrument",
    "outcome",
    "evidence_sha256"
  ],
  "properties": {
    "schema": {
      "const": "skrsi.evaluation.v4"
    },
    "evaluation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "target_ref": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+@[1-9][0-9]*$"
    },
    "participants": {
      "description": "Exactly [producer, independent evaluator], in that order.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      ],
      "items": false
    },
    "baseline": {
      "$ref": "#/$defs/cohort"
    },
    "treatment": {
      "$ref": "#/$defs/cohort"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "missingness": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_class": {
      "description": "What kind of measurement produced the metrics. synthetic is a fixture or offline corpus and can never support pass.",
      "enum": [
        "synthetic",
        "live_self_retrieval",
        "live_labelled"
      ]
    },
    "instrument": {
      "description": "Self-description of the measuring instrument. runs_production_code false caps the outcome below pass.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs_production_code",
        "baselines_named",
        "sabotage_tested",
        "dead_arms_reported"
      ],
      "properties": {
        "runs_production_code": {
          "type": "boolean"
        },
        "baselines_named": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "sabotage_tested": {
          "type": "boolean"
        },
        "dead_arms_reported": {
          "type": "boolean"
        }
      }
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "inconclusive",
        "regression"
      ]
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "pass"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "guardrails": {
            "items": {
              "properties": {
                "passed": {
                  "const": true
                }
              },
              "required": [
                "passed"
              ]
            }
          },
          "missingness": {
            "maxItems": 0
          },
          "metrics": {
            "items": {
              "properties": {
                "baseline": {
                  "type": "number"
                },
                "treatment": {
                  "type": "number"
                }
              },
              "required": [
                "baseline",
                "treatment"
              ]
            }
          },
          "evidence_class": {
            "enum": [
              "live_self_retrieval",
              "live_labelled"
            ]
          },
          "instrument": {
            "properties": {
              "runs_production_code": {
                "const": true
              }
            },
            "required": [
              "runs_production_code"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sample_size",
        "window_start",
        "window_end"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "baseline",
        "treatment"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "baseline": {
          "type": [
            "number",
            "null"
          ]
        },
        "treatment": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
