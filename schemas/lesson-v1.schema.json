{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smilintux.github.io/skrsi/schemas/lesson-v1.schema.json",
  "title": "SKRSI lesson v1",
  "description": "Front matter of a canon page of type lesson. Tags must also appear in schemas/lesson-tags-v1.json; validate_public.lesson_errors is the normative validator. There is no recurrence field: recurrence is counted in evidence records, never authored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "type", "title", "service", "tags", "class", "evidence", "rule", "check", "status", "visibility"],
  "properties": {
    "schema": {"const": "skrsi.lesson.v1"},
    "id": {"type": "string", "pattern": "^(?![\\s\\S]*\\n)lesson-[a-z0-9][a-z0-9-]{2,95}$"},
    "type": {"const": "lesson"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^(?![\\s\\S]*\\n)[^\\n]+$"},
    "service": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?![\\s\\S]*\\n)[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64}
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?![\\s\\S]*\\n)[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64}
    },
    "class": {"enum": ["defect", "efficiency", "reliability", "process"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"enum": ["pr", "review", "incident", "problem", "card", "artifact", "evaluation"]},
          "ref": {"type": "string", "pattern": "^(?![\\s\\S]*\\n)[A-Za-z0-9][A-Za-z0-9._:/#@-]{0,199}$"}
        }
      }
    },
    "rule": {
      "description": "One actionable sentence, 40 words at most.",
      "type": "string",
      "maxLength": 400,
      "pattern": "^(?![\\s\\S]*\\n)\\s*\\S+(?:\\s+\\S+){0,39}\\s*$"
    },
    "check": {
      "description": "The test, lint or doctor rule that enforces the lesson, or the literal none yet.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*\\n)[^\\n]+$"
    },
    "status": {"enum": ["proposed", "active", "enforced", "retired"]},
    "visibility": {"enum": ["public", "private"]},
    "namespace": {
      "description": "Canon envelope (optional): the canon namespace, ops for skbrain-ops pages.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?![\\s\\S]*\\n)[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "lifecycle": {
      "description": "Canon envelope (optional): the canon review state of the page.",
      "enum": ["draft", "reviewed", "canon"]
    },
    "edges": {
      "description": "Canon envelope (optional): typed links to other canon pages, in the canon edge shape.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target"],
        "properties": {
          "target": {"type": "string", "maxLength": 200, "pattern": "^(?![\\s\\S]*\\n)[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
          "type": {"type": "string", "maxLength": 64, "pattern": "^(?![\\s\\S]*\\n)[a-z][a-z0-9_]*$"}
        }
      }
    },
    "created": {
      "description": "Canon envelope (optional): ISO 8601 calendar date. Consumers normalize YAML dates to this string form before validating.",
      "type": "string",
      "format": "date",
      "pattern": "^(?![\\s\\S]*\\n)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated": {
      "description": "Canon envelope (optional): ISO 8601 calendar date. Consumers normalize YAML dates to this string form before validating.",
      "type": "string",
      "format": "date",
      "pattern": "^(?![\\s\\S]*\\n)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
 ,
    "state_refs": {
      "description": "Canon envelope (optional): pointers into operational stores, never state itself. kedb is a known-error id; actions are operator standard-action names.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kedb": {"type": "string", "maxLength": 100, "pattern": "^(?![\\s\\S]*\\n)ke-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "actions": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 64, "pattern": "^(?![\\s\\S]*\\n)[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "enforced"}}, "required": ["status"]},
      "then": {"properties": {"check": {"not": {"const": "none yet"}}}}
    }
  ]
}
